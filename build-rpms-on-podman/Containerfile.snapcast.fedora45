from docker.io/library/fedora:45

# https://github.com/badaix/snapcast/blob/develop/doc/build.md

RUN set -ex;\
  rm -rf /opt/usr; \
  mkdir -p /opt/usr/share/snapserver/snapweb /opt/usr/share/man/man1 \
    /opt/usr/share/pixmaps /opt//usr/share/snapserver/plug-ins \
    /opt/usr/bin /opt/etc/snapserver/certs || true; \
  cd; \
  echo "fastestmirror=1" >>/etc/dnf/dnf.conf; \
  dnf -y install \
  https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm; \
  dnf -y install \
  https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm; \
  dnf -y install \
  git @development-tools cmake \
  openssl-devel \
  pipewire-devel pipewire-pulseaudio  dbus-devel \
  pipewire-jack-audio-connection-kit-devel portaudio-devel \
  alsa-lib-devel avahi-devel gcc-c++ libatomic libvorbis-devel \
  opus-devel pulseaudio-libs-devel\
  flac-devel soxr-devel libstdc++-static expat-devel boost-devel rubygems; \
  gem install fpm; \
  mkdir -p /src || true; \
  cd /src;

RUN set -ex; \
  export CMAKE_INSTALL_PREFIX=/usr; \
  export CMAKE_INSTALL_FULL_SYSCONFDIR=/etc; \
  export CMAKE_INSTALL_FULL_LOCALSTATEDIR=/var; \
  cd /src; \
  if [ -d snapcast/.git ]; then \
    cd snapcast; git reset --hard; git pull; cd ..; \
  else \
    rm -rf snapcast || true; \
    # git clone --depth 10 -b feature/1371-server-pipewire-support https://github.com/aanno/snapcast.git ; \
    # using my fork
    # git clone --depth 10 -b feature/controlled-async-loop-2 https://github.com/aanno/snapcast.git ; \
    # git clone --depth 10 -b feature/librist-2 https://github.com/aanno/snapcast.git ; \
    git clone --depth 10 https://github.com/badaix/snapcast.git; \
  fi; \
  cd snapcast; \
  mkdir build || true; \
  cd build; \
  cmake .. -DBUILD_CLIENT=ON -DBUILD_SERVER=ON -DBUILD_WITH_PULSE=ON \
    -DBUILD_WITH_JACK=OFF -DBUILD_WITH_PIPEWIRE=ON -DCMAKE_INSTALL_FULL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_FULL_LOCALSTATEDIR=/var; \
  # cmake --build .; \
  make clean; \
  make -j8; \
  cmake --install .; \
  cp /usr/bin/snapserver /opt/usr/bin/; \
  cp /usr/share/man/man1/snapserver.* /opt/usr/share/man/man1/; \
  rm -r /opt/usr/share/snapserver || true; \
  cp -r /usr/share/snapserver /opt/usr/share/; \
  cp /usr/etc/snapserver.conf /opt/etc/snapserver.conf; \
  rm -r /opt/usr/etc/snapserver/certs || true; \
  cp -r /usr/etc/snapserver/certs /opt/etc/snapserver/; \
  cp /usr/bin/snapclient /opt/usr/bin/; \
  cp /usr/share/man/man1/snapclient.* /opt/usr/share/man/man1/; \
  cp /usr/share/pixmaps/snapcast.svg /opt/usr/share/pixmaps/; \
  rm -r /opt/usr/share/snapserver || true; \
  cp -r /usr/share/snapserver /opt/usr/share/; \
  cd /opt; \
  tar cvfz /src/snapcast.tar.gz \
    usr/bin/snap* \
    usr/share/snapserver \
    usr/share/man/man1/snap* \
    usr/share/pixmaps/snapcast.svg \
    etc/snapserver.conf \
    etc/snapserver/certs;
