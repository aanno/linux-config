from docker.io/library/fedora:45

# Problem: Does not compile, see https://github.com/hzeller/gmrender-resurrect/issues/296
# Fixed by: https://github.com/hzeller/gmrender-resurrect/pull/297
# https://github.com/hzeller/gmrender-resurrect/blob/master/INSTALL.md

RUN set -ex; \
  echo "fastestmirror=1" >>/etc/dnf/dnf.conf; \
  dnf -y install \
  https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm; \
  dnf -y install \
  https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm; \
  dnf -y install \
  git automake autoconf gettext libtool pkg-config \
  gstreamer1-devel  gstreamer1-plugins-base  gstreamer1-plugins-good \
  gstreamer1-plugins-bad-freeworld gstreamer1-plugins-ugly gstreamer1-plugin-libav \
  libupnp-devel pipewire-pulseaudio pipewire-gstreamer pipewire-devel rubygems; \
  gem install fpm; \
  mkdir -p /src || true; \
  cd /src; \
  rm -rf gmrender-resurrect || true;

RUN set -ex; \
  cd /src; \
  git clone --depth 10 -b aanno/issue-296 https://github.com/aanno/gmrender-resurrect.git; \
  # git --depth 10 clone https://github.com/hzeller/gmrender-resurrect.git; \
  cd gmrender-resurrect; \
  ./autogen.sh; \
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var; \
  make; \
  make install; \
  rm -rf /opt/usr || true; \
  mkdir -p /opt/usr/bin; \
  cp /usr/bin/gmed* /opt/usr/bin/; \
  mkdir -p /opt/usr/share; \
  cp -r /usr/share/gmediarender /opt/usr/share; \
  cd /opt; \
  tar cvfz gmrender.tar.gz usr; \
  mv /opt/gmrender.tar.gz /src;
